# Hermes Agent Portable - 配置文件模板
# 复制此文件为 .env 并填入你的 API 密钥
# 至少需要配置一个 LLM provider

# ===== LLM Provider (至少配一个) =====
# ANTHROPIC_API_KEY=sk-ant-xxx
# OPENAI_API_KEY=sk-xxx
# OPENROUTER_API_KEY=sk-or-xxx
# GOOGLE_API_KEY=xxx

# ===== 可选工具 =====
# FIRECRAWL_API_KEY=fc-xxx
# EXA_API_KEY=xxx
# FAL_KEY=xxx

# ===== 可选集成 =====
# TELEGRAM_BOT_TOKEN=xxx
# DISCORD_TOKEN=xxx
