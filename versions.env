# Uhermes 便携包 — 版本钉定（唯一真相源）
#
# 构建脚本 build/build.py 读取本文件；README 里的版本号也必须与此保持一致。
# 升级上游 Hermes 时只改这里，然后重新构建即可。

# ---- 上游 Hermes Agent ----
# 语义版本号（用于 hermes-agent 包版本校验与 README 展示）
HERMES_VERSION=0.21.5
# git tag（用于下载源码 tarball：https://github.com/NousResearch/hermes-agent/archive/refs/tags/<tag>.tar.gz）
HERMES_TAG=v2026.9.24
# tag 指向的 commit（用于审计/核对，构建不直接使用）
HERMES_COMMIT=f97608f178d1ffeca59860195ab7da295f7c8e5f
# 上游发布日
HERMES_RELEASED=2026-09-24

# ---- 便携 Python 运行时（python-build-standalone）----
# 官方 .python-version 与 requires-python(>=3.11,<3.14) 都指向 3.11
PYTHON_VERSION=3.11.17
# python-build-standalone 的 release 标签
PBS_RELEASE=20261003
PBS_VERSION_TAG=20261003
# 归档变体：install_only_stripped（体积最小，含 pip）
PBS_VARIANT=install_only_stripped

# ---- 可选：随包捆绑的 uv（--with-uv 时使用）----
# 让 Hermes 的「按需安装可选依赖」在便携包内可用（仍需联网访问 PyPI）
UV_VERSION=0.12.6

# ---- 目标平台三元组 ----
TRIPLE_WINDOWS=x86_64-pc-windows-msvc
TRIPLE_LINUX=x86_64-unknown-linux-gnu
