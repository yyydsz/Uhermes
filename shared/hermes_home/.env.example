# =============================================================================
#  Uhermes 便携版 — .env 密钥模板
#
#  用法：复制本文件为同目录下的 .env，取消你要用的行的注释并填入密钥。
#        （便携启动器在首次运行时会自动帮你复制一份空的 .env）
#
#  规则（来自上游 Hermes 的约定）：
#    * .env 只放「凭据」—— API 密钥、Bot Token、密码。
#    * 一切「设置」都放 config.yaml（模型、显示、终端、压缩等），不要写在这里。
#    * 一个密钥都不填也能启动：Hermes 内置免费额度 / 登录流程（进入后输入 /login）。
#
#  最省事的配置方式（推荐）：./start.sh setup   或   start.bat setup
#  它会引导你选 provider、填密钥、选默认模型，并自动写好这两个文件。
#
#  完整清单（离线可查）：hermes_home/reference/env.full.example
# =============================================================================

# -----------------------------------------------------------------------------
# LLM Provider —— 至少填一个，或走 /login 免费额度
# -----------------------------------------------------------------------------
# OpenRouter：一个密钥用遍各家模型，入门最省事
# 申请：https://openrouter.ai/keys
# OPENROUTER_API_KEY=

# 官方直连
# 申请：https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=
# 申请：https://platform.openai.com/api-keys
# OPENAI_API_KEY=

# Google Gemini（两家任一即可，GEMINI_API_KEY 走 OpenAI 兼容端点）
# 申请：https://aistudio.google.com/apikey
# GOOGLE_API_KEY=
# GEMINI_API_KEY=

# 国内可直连的常见选择
# 智谱 GLM：https://open.bigmodel.cn/
# GLM_API_KEY=
# 月之暗面 Kimi：https://platform.moonshot.cn/
# KIMI_API_KEY=
# MiniMax：https://platform.minimaxi.com/
# MINIMAX_API_KEY=

# 其他 OpenAI 兼容聚合/推理服务（按需取用）
# FIREWORKS_API_KEY=
# NOVITA_API_KEY=
# DEEPINFRA_API_KEY=
# NEBIUS_API_KEY=
# XIAOMI_API_KEY=
# OLLAMA_API_KEY=              # Ollama Cloud；本地 Ollama 不需要密钥

# 本地推理（LM Studio / Ollama / vLLM）不需要密钥，
# 请在 config.yaml 里设 model.provider 与 model.base_url。

# -----------------------------------------------------------------------------
# 联网检索（可选；不填时 Hermes 会退化到免密钥的检索通道）
# -----------------------------------------------------------------------------
# EXA_API_KEY=                 # https://exa.ai/
# PARALLEL_API_KEY=            # https://parallel.ai/
# FIRECRAWL_API_KEY=           # https://firecrawl.dev/

# -----------------------------------------------------------------------------
# 多模态：图片 / 视频生成、语音
# -----------------------------------------------------------------------------
# FAL_KEY=                     # 图片/视频生成 https://fal.ai/
# ELEVENLABS_API_KEY=          # 高质量 TTS/STT https://elevenlabs.io/
# VOICE_TOOLS_OPENAI_KEY=      # OpenAI 语音转写/TTS 专用密钥（可留空复用 OPENAI_API_KEY）
# GROQ_API_KEY=                # Groq 推理 + 高速转写 https://console.groq.com/
# HF_TOKEN=                     # Hugging Face 模型/数据集 https://huggingface.co/settings/tokens

# -----------------------------------------------------------------------------
# 消息平台 Gateway（把 Agent 接到聊天软件里，可选）
# -----------------------------------------------------------------------------
# 填完后运行：start.sh gateway     或   start.bat gateway
# 各平台的完整变量请用交互式向导生成：start.sh gateway setup
# TELEGRAM_BOT_TOKEN=          # @BotFather 申请
# DISCORD_BOT_TOKEN=           # 注意键名是 DISCORD_BOT_TOKEN
# SLACK_BOT_TOKEN=
# SLACK_APP_TOKEN=

# -----------------------------------------------------------------------------
# 记忆 / 开发集成（可选）
# -----------------------------------------------------------------------------
# HONCHO_API_KEY=              # Honcho 云端记忆
# GITHUB_TOKEN=                # GitHub 操作、Copilot 走 GitHub Models 时需要

# -----------------------------------------------------------------------------
# 浏览器自动化（可选；需要系统里有 Node.js）
# -----------------------------------------------------------------------------
# BROWSERBASE_API_KEY=         # 云端浏览器，本地无 Chrome 时可用
