# =============================================================================
#  Uhermes 便携版 — config.yaml 模板（设置项）
#
#  用法：复制本文件为同目录下的 config.yaml，按需取消注释。
#        （便携启动器在首次运行时会自动帮你复制一份到 config.yaml）
#
#  本文件里所有键都是「注释状态」，因此复制过去等价于使用 Hermes 默认值 —— 安全。
#  规则：密钥写 .env，设置写这里。
#
#  改配置的三种方式：
#    1) 交互式：  start.sh setup          （Windows: start.bat setup）
#    2) 命令行：  start.sh config set display.skin ares
#    3) 直接编辑本文件（注释会被保留）
#
#  完整键表（离线可查，约 2300 行）：hermes_home/reference/config.full.example
# =============================================================================

# -----------------------------------------------------------------------------
# 默认模型
# -----------------------------------------------------------------------------
# model:
#   # 模型名，可用 --model 临时覆盖
#   # 例：anthropic/claude-opus-4.6、openai/gpt-5.1、google/gemini-3-pro
#   default: "anthropic/claude-opus-4.6"
#   # provider 默认 "auto"（按已有密钥自动判断）。
#   # 可选：openrouter / anthropic / gemini / zai / kimi-coding / minimax /
#   #       deepinfra / huggingface / nous / openai-codex / copilot / lmstudio / custom
#   provider: "auto"
#   # 走自建/中转端点时改这里（provider 用 custom/ollama/vllm/llamacpp）
#   base_url: "https://openrouter.ai/api/v1"

# -----------------------------------------------------------------------------
# 数据库 —— U盘用户重点看这一项
# -----------------------------------------------------------------------------
# database:
#   # WAL 是默认值，性能最好，但它需要可靠的文件锁与 fsync。
#   # 如果便携包放在 exFAT/FAT32 的 U 盘、网络盘（NFS/SMB）上，
#   # 建议改成 "delete"，否则 SQLite 可能报 WAL 不兼容或偶尔损坏。
#   journal_mode: "delete"      # wal | delete

# -----------------------------------------------------------------------------
# 会话与磁盘占用（U盘空间有限时很有用）
# -----------------------------------------------------------------------------
# sessions:
#   auto_prune: true            # 自动清理旧会话
#   retention_days: 90
#   auto_archive: true
#   auto_archive_days: 30

# logging:
#   level: "INFO"               # DEBUG/INFO/WARNING/ERROR
#   max_size_mb: 5              # 日志轮转上限，减少 U盘写入
#   backup_count: 3

# -----------------------------------------------------------------------------
# 界面
# -----------------------------------------------------------------------------
# display:
#   skin: "default"             # 内置主题：default / ares / mono / slate
#   language: "zh"              # 界面与回复语言（留空=跟随系统）
#   show_reasoning: true        # 显示模型思考过程
#   streaming: true

# -----------------------------------------------------------------------------
# 终端工具（Agent 执行命令的地方）
# -----------------------------------------------------------------------------
# terminal:
#   backend: "local"            # local | docker | ssh | modal | singularity | daytona
#   cwd: "."                    # Agent 的工作目录（相对启动目录）
#   timeout: 120                # 单条命令超时（秒）
#   # backend 用 docker 时才需要：
#   # docker_image: "python:3.11-slim"

# -----------------------------------------------------------------------------
# 上下文压缩（长对话省钱的关键）
# -----------------------------------------------------------------------------
# compression:
#   enabled: true
#   threshold: 0.75             # 上下文占用超过该比例时触发压缩

# agent:
#   max_turns: 50               # 单次任务的最大轮数

# -----------------------------------------------------------------------------
# 联网检索
# -----------------------------------------------------------------------------
# web:
#   search_backend: "auto"      # 按已配置的密钥自动选择
#   cache_enabled: true

# -----------------------------------------------------------------------------
# 技能与记忆
# -----------------------------------------------------------------------------
# skills:
#   auto_load: []               # 每次新会话都注入的技能名
#   external_dirs: []           # 额外的技能搜索目录（可放 U 盘上的共享技能）
#   project_discovery: true     # 允许项目内 skills/ 目录自动生效

# memory:
#   memory_enabled: true        # 让 Agent 自己积累笔记
#   user_profile_enabled: true  # 维护你的偏好画像

# -----------------------------------------------------------------------------
# 懒加载依赖（便携场景建议保持默认）
# -----------------------------------------------------------------------------
# security:
#   # 某些能力（如消息平台、语音）首次使用时会按需下载依赖。
#   # 便携启动器已把它们装进 hermes_home/lazy-deps（跟着 U盘走）。
#   # 完全离线/只读介质上使用，可设为 false 关闭按需安装。
#   allow_lazy_installs: true

# -----------------------------------------------------------------------------
# 更新检查
# -----------------------------------------------------------------------------
# updates:
#   # 便携包不能就地自更新（见 README「更新」一节），
#   # 关掉检查可以避免每次启动都联网请求。
#   check: false
